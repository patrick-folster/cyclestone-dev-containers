{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://cyclestone.dev/schemas/provider-credential-state-v1.schema.json","title":"Cyclestone provider credential state v1",
  "type":"object","additionalProperties":false,
  "required":["version","grant_id","identity_fingerprint","request_fingerprint","provider_id","mode","strategy","project_path","source_path","source_device","source_inode","store_file","container_destination","sessions"],
  "properties":{
    "version":{"const":1},"grant_id":{"$ref":"#/$defs/sha"},"identity_fingerprint":{"$ref":"#/$defs/sha"},"request_fingerprint":{"$ref":"#/$defs/sha"},
    "provider_id":{"type":"string","pattern":"^[a-z][a-z0-9-]{1,62}[a-z0-9]$"},"mode":{"enum":["read-only","read-write","environment","host-service"]},"strategy":{"enum":["direct-file-mount","isolated-store","runtime-environment","host-service"]},
    "project_path":{"type":"string","pattern":"^/"},"source_path":{"oneOf":[{"type":"string","pattern":"^/"},{"type":"null"}]},"source_device":{"type":["integer","null"],"minimum":0},"source_inode":{"type":["integer","null"],"minimum":1},"store_file":{"oneOf":[{"type":"string","pattern":"^/"},{"type":"null"}]},"container_destination":{"oneOf":[{"type":"string","enum":["/home/developer/.codex/auth.json","/home/developer/.local/share/opencode/auth.json"]},{"type":"null"}]},
    "sessions":{"type":"array","uniqueItems":true,"items":{"type":"object","additionalProperties":false,"required":["id","container_id","started_at"],"properties":{"id":{"$ref":"#/$defs/sha"},"container_id":{"type":"string","pattern":"^[0-9a-f]{12,64}$"},"started_at":{"type":"string","pattern":"^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"}}}}
  },
  "$defs":{"sha":{"type":"string","pattern":"^[0-9a-f]{64}$"}}
}
