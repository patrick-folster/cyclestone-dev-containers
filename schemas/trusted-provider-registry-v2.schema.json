{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyclestone.dev/schemas/trusted-provider-registry-v2.schema.json",
  "title": "Cyclestone trusted provider registry v2",
  "description": "Generic data-driven provider registry. Provider definitions are self-describing; adapter coherence is enforced by strategy-family oneOf branches, not per-ID code branches. Closed enums on source_files, environment_names, and container_destination preserve the v1 fail-closed access boundary. Adding a provider with a new source path, env name, or destination requires an enum expansion (schema change + security review + snapshot update). Adding a provider using only existing enum values requires a registry edit + snapshot update + CHANGELOG, with zero shell edits.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "registry_version",
    "definitions"
  ],
  "properties": {
    "registry_version": {
      "const": 2
    },
    "definitions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/provider"
      }
    }
  },
  "$defs": {
    "providerId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,62}[a-z0-9]$"
    },
    "sourceFile": {
      "enum": [
        "${HOME}/.codex/auth.json",
        "${HOME}/.local/share/opencode/auth.json"
      ]
    },
    "envName": {
      "enum": [
        "ANTHROPIC_API_KEY",
        "HTTPS_PROXY",
        "HTTP_PROXY",
        "NO_PROXY",
        "OLLAMA_HOST",
        "GEMINI_API_KEY"
      ]
    },
    "containerDestination": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        null,
        "/home/developer/.codex/auth.json",
        "/home/developer/.local/share/opencode/auth.json"
      ]
    },
    "failureCode": {
      "type": "string",
      "pattern": "^E_[A-Z_]+$"
    },
    "cli": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "location"
      ],
      "properties": {
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "location": {
          "enum": [
            "container",
            "none"
          ]
        }
      },
      "oneOf": [
        {
          "properties": {
            "location": {
              "const": "none"
            },
            "name": {
              "type": "null"
            }
          }
        },
        {
          "properties": {
            "location": {
              "const": "container"
            },
            "name": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "endpoint_environment",
        "default_endpoint",
        "transport",
        "authentication"
      ],
      "properties": {
        "kind": {
          "const": "http"
        },
        "endpoint_environment": {
          "$ref": "#/$defs/envName"
        },
        "default_endpoint": {
          "type": "string",
          "pattern": "^https?://[^\\s]+$"
        },
        "transport": {
          "const": "tcp"
        },
        "authentication": {
          "const": "none"
        }
      }
    },
    "adapterBase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "adapter_version",
        "strategy",
        "source_files",
        "environment_names",
        "container_destination",
        "access",
        "import_behavior",
        "synchronization",
        "refresh_behavior",
        "revocation_behavior",
        "directory_mode",
        "file_mode",
        "backup_policy",
        "failure_codes"
      ],
      "properties": {
        "mode": {
          "enum": [
            "read-only",
            "read-write",
            "environment",
            "host-service"
          ]
        },
        "adapter_version": {
          "const": 1
        },
        "strategy": {
          "enum": [
            "direct-file-mount",
            "isolated-store",
            "runtime-environment",
            "host-service"
          ]
        },
        "source_files": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/sourceFile"
          }
        },
        "environment_names": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/envName"
          }
        },
        "container_destination": {
          "$ref": "#/$defs/containerDestination"
        },
        "access": {
          "enum": [
            "read-only",
            "read-write",
            "environment",
            "host-service"
          ]
        },
        "import_behavior": {
          "type": "string",
          "minLength": 1
        },
        "synchronization": {
          "type": "string",
          "minLength": 1
        },
        "refresh_behavior": {
          "type": "string",
          "minLength": 1
        },
        "revocation_behavior": {
          "type": "string",
          "minLength": 1
        },
        "directory_mode": {
          "type": [
            "integer",
            "null"
          ],
          "enum": [
            null,
            700
          ]
        },
        "file_mode": {
          "type": [
            "integer",
            "null"
          ],
          "enum": [
            null,
            600
          ]
        },
        "backup_policy": {
          "type": "string",
          "minLength": 1
        },
        "failure_codes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/failureCode"
          }
        }
      }
    },
    "runtimeEnvironmentAdapter": {
      "allOf": [
        {
          "$ref": "#/$defs/adapterBase"
        },
        {
          "properties": {
            "mode": {
              "const": "environment"
            },
            "strategy": {
              "const": "runtime-environment"
            },
            "access": {
              "const": "environment"
            },
            "source_files": {
              "const": []
            },
            "environment_names": {
              "type": "array",
              "minItems": 1
            },
            "container_destination": {
              "const": null
            },
            "directory_mode": {
              "const": null
            },
            "file_mode": {
              "const": null
            }
          }
        }
      ]
    },
    "hostServiceAdapter": {
      "allOf": [
        {
          "$ref": "#/$defs/adapterBase"
        },
        {
          "properties": {
            "mode": {
              "const": "host-service"
            },
            "strategy": {
              "const": "host-service"
            },
            "access": {
              "const": "host-service"
            },
            "source_files": {
              "const": []
            },
            "environment_names": {
              "type": "array",
              "minItems": 1
            },
            "container_destination": {
              "const": null
            },
            "directory_mode": {
              "const": null
            },
            "file_mode": {
              "const": null
            }
          }
        }
      ]
    },
    "directFileMountAdapter": {
      "allOf": [
        {
          "$ref": "#/$defs/adapterBase"
        },
        {
          "properties": {
            "mode": {
              "const": "read-only"
            },
            "strategy": {
              "const": "direct-file-mount"
            },
            "access": {
              "const": "read-only"
            },
            "source_files": {
              "type": "array",
              "minItems": 1,
              "maxItems": 1
            },
            "environment_names": {
              "const": []
            },
            "container_destination": {
              "type": "string",
              "minLength": 1
            },
            "directory_mode": {
              "const": null
            },
            "file_mode": {
              "const": 600
            }
          }
        },
        {
          "if": {
            "properties": {
              "source_files": {
                "type": "array",
                "contains": {
                  "const": "${HOME}/.codex/auth.json"
                }
              }
            }
          },
          "then": {
            "properties": {
              "container_destination": {
                "const": "/home/developer/.codex/auth.json"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "source_files": {
                "type": "array",
                "contains": {
                  "const": "${HOME}/.local/share/opencode/auth.json"
                }
              }
            }
          },
          "then": {
            "properties": {
              "container_destination": {
                "const": "/home/developer/.local/share/opencode/auth.json"
              }
            }
          }
        }
      ]
    },
    "isolatedStoreAdapter": {
      "allOf": [
        {
          "$ref": "#/$defs/adapterBase"
        },
        {
          "properties": {
            "mode": {
              "const": "read-write"
            },
            "strategy": {
              "const": "isolated-store"
            },
            "access": {
              "const": "read-write"
            },
            "source_files": {
              "type": "array",
              "minItems": 1,
              "maxItems": 1
            },
            "environment_names": {
              "const": []
            },
            "container_destination": {
              "type": "string",
              "minLength": 1
            },
            "directory_mode": {
              "const": 700
            },
            "file_mode": {
              "const": 600
            }
          }
        },
        {
          "if": {
            "properties": {
              "source_files": {
                "type": "array",
                "contains": {
                  "const": "${HOME}/.codex/auth.json"
                }
              }
            }
          },
          "then": {
            "properties": {
              "container_destination": {
                "const": "/home/developer/.codex/auth.json"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "source_files": {
                "type": "array",
                "contains": {
                  "const": "${HOME}/.local/share/opencode/auth.json"
                }
              }
            }
          },
          "then": {
            "properties": {
              "container_destination": {
                "const": "/home/developer/.local/share/opencode/auth.json"
              }
            }
          }
        }
      ]
    },
    "adapter": {
      "oneOf": [
        {
          "$ref": "#/$defs/runtimeEnvironmentAdapter"
        },
        {
          "$ref": "#/$defs/hostServiceAdapter"
        },
        {
          "$ref": "#/$defs/directFileMountAdapter"
        },
        {
          "$ref": "#/$defs/isolatedStoreAdapter"
        }
      ]
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "display_name",
        "description",
        "supported_modes",
        "recommended_mode",
        "platforms",
        "required_cli",
        "adapters",
        "security_guidance"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/providerId"
        },
        "display_name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "supported_modes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "read-only",
              "read-write",
              "environment",
              "host-service"
            ]
          }
        },
        "recommended_mode": {
          "enum": [
            "read-only",
            "read-write",
            "environment",
            "host-service"
          ]
        },
        "platforms": {
          "const": [
            "linux"
          ]
        },
        "required_cli": {
          "$ref": "#/$defs/cli"
        },
        "adapters": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/adapter"
          }
        },
        "host_service": {
          "$ref": "#/$defs/service"
        },
        "security_guidance": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "adapters": {
                "contains": {
                  "properties": {
                    "strategy": {
                      "const": "host-service"
                    }
                  }
                }
              }
            }
          },
          "then": {
            "required": [
              "host_service"
            ]
          },
          "else": {
            "not": {
              "required": [
                "host_service"
              ]
            }
          }
        }
      ]
    }
  }
}
